# Copy to .env.local and fill in to run `yarn deploy.web`.

# Storage Zone name, and its password from Storage > FTP & API Access
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Only needed if the zone's main region is not Falkenstein, e.g. ny.storage.bunnycdn.com
BUNNY_STORAGE_HOSTNAME=

# Account API key from Account settings > API, and the Pull Zone's numeric ID
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
