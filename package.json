{
  "name": "@neurodevs/personomic",
  "description": "A platform for individualized precision neuroinformatics and biosignal experiments",
  "type": "module",
  "keywords": [
    "nodejs",
    "typescript",
    "tdd"
  ],
  "license": "MIT",
  "author": "Eric Yates <hello@ericthecurious.com>",
  "homepage": "https://github.com/neurodevs/personomic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurodevs/personomic.git"
  },
  "bugs": {
    "url": "https://github.com/neurodevs/personomic/issues"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build.ci": "yarn run build.types && yarn run lint && yarn run test.ci",
    "build.dev": "yarn run build.types ; yarn run fix.lint ; prettier --write . --log-level warn",
    "build.types": "tsc --noEmit",
    "build.web": "expo export -p web",
    "clean": "yarn run clean.build",
    "clean.all": "yarn run clean.dependencies && yarn run clean.build",
    "clean.build": "rm -rf .expo/ dist/ web-build/",
    "clean.dependencies": "rm -rf node_modules/ package-lock.json yarn.lock",
    "fix.lint": "eslint --fix --cache \"**/*.ts\" \"**/*.tsx\"",
    "lint": "eslint --cache \"**/*.ts\" \"**/*.tsx\"",
    "rebuild": "yarn run clean.all && yarn install && yarn run build.dev",
    "update.dependencies": "yarn run clean.dependencies && yarn",
    "test": "jest",
    "test.ci": "jest --ci --testTimeout=20000",
    "watch.build.dev": "tsc --noEmit --watch",
    "watch.test": "jest --watch"
  },
  "dependencies": {
    "expo": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@neurodevs/eslint-config-ndx": "^2.0.3",
    "@neurodevs/generate-id": "^1.1.3",
    "@neurodevs/node-tdd": "^3.0.3",
    "@neurodevs/prettier-config-ndx": "^1.0.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testRunner": "jest-circus/runner",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@neurodevs/.*|chalk|ansi-styles|lodash-es|deep-equal|variable-diff|ts-expect|generate-id))"
    ],
    "testTimeout": 5000,
    "maxWorkers": 4
  },
  "version": "0.0.1"
}
