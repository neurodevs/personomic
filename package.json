{
  "name": "@neurodevs/personomic",
  "description": "A platform for individualized precision neuroinformatics and biosignal experiments",
  "type": "module",
  "keywords": [
    "nodejs",
    "typescript",
    "tdd"
  ],
  "license": "MIT",
  "author": "Eric Yates <hello@ericthecurious.com>",
  "homepage": "https://github.com/neurodevs/personomic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurodevs/personomic.git"
  },
  "bugs": {
    "url": "https://github.com/neurodevs/personomic/issues"
  },
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "yarn run build.types && vite build",
    "preview": "vite preview",
    "build.ci": "yarn run build.types && yarn run lint && yarn run test.ci",
    "build.dev": "yarn run build.types ; yarn run fix.lint ; prettier --write . --log-level warn",
    "build.types": "tsc --noEmit",
    "clean": "yarn run clean.build",
    "clean.all": "yarn run clean.dependencies && yarn run clean.build",
    "clean.build": "rm -rf dist/",
    "clean.dependencies": "rm -rf node_modules/ package-lock.json yarn.lock",
    "fix.lint": "eslint --fix --cache \"**/*.ts\" \"**/*.tsx\"",
    "lint": "eslint --cache \"**/*.ts\" \"**/*.tsx\"",
    "rebuild": "yarn run clean.all && yarn install && yarn run build.dev",
    "run.fakeStreams": "node scripts/runFakeStreams.mjs",
    "run.muse": "node scripts/runMuse.mjs",
    "update.dependencies": "yarn run clean.dependencies && yarn",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test.ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --testTimeout=20000",
    "watch.build.dev": "tsc --noEmit --watch",
    "watch.test": "NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "dependencies": {
    "@neurodevs/node-biosignal-processing": "^1.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@neurodevs/eslint-config-ndx": "^2.0.3",
    "@neurodevs/fake-node-core": "^0.13.0",
    "@neurodevs/generate-id": "^1.1.3",
    "@neurodevs/node-biosensors": "^8.1.0",
    "@neurodevs/node-lsl": "^23.1.1",
    "@neurodevs/node-tdd": "^3.0.3",
    "@neurodevs/prettier-config-ndx": "^1.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-jest": "^29.7.0",
    "eslint": "^10.9.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^7.3.6"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "testRunner": "jest-circus/runner",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^uplot$": "<rootDir>/src/testDoubles/UPlot/FakeUPlot.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@neurodevs/.*|chalk|ansi-styles|lodash-es|deep-equal|variable-diff|ts-expect|generate-id))"
    ],
    "testTimeout": 5000,
    "maxWorkers": 4
  },
  "version": "0.0.1"
}
